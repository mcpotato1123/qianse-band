<template>
  <div class="page" onswipe="ban">
    <!-- 原作标题画：整张等比显示（336×189），不裁切、不平移 -->
    <image class="bg" src="{{bgSrc}}"></image>
    <!-- 原作 logotype，放在封面左下角 -->
    <image class="logo" src="{{logoSrc}}"></image>

    <div class="sheet">
      <text class="mi" onclick="start" onswipe="ban">开始阅读</text>
      <text class="mi" onclick="resume" if="{{hasAuto}}" onswipe="ban">继续阅读</text>
      <text class="mi" onclick="openChapters" onswipe="ban">章节选择</text>
      <text class="mi" onclick="openCg" onswipe="ban">CG 鉴赏</text>
      <text class="mi" onclick="openSettings" onswipe="ban">设置</text>
      <text class="mi" onclick="openAbout" onswipe="ban">关于</text>
      <text class="mi mi-quit" onclick="exitApp" onswipe="ban">退出应用</text>
    </div>
  </div>
</template>

<style>
  .page { width: 336px; height: 480px; background-color: #f5f5f7; position: relative; }
  .bg { position: absolute; top: 0px; left: 0px; width: 336px; height: 191px;
        object-fit: fill; }
  .logo { position: absolute; top: 107px; left: 8px; width: 140px; height: 76px;
          object-fit: contain; }

  /* 浅色卡片式菜单：白底大字号，和参考工程一致；紧贴封面，别留缝 */
  .sheet { position: absolute; top: 189px; left: 0px; width: 336px; height: 291px;
           background-color: #f5f5f7;
           flex-direction: column; align-items: center; padding-top: 6px; }
  .mi { width: 300px; height: 38px; text-align: center; font-size: 26px; color: #000000;
        font-weight: 800; border-bottom: 1px solid #e0e0e0; }
  /* 退出单独标色，避免和「关于」挨着误触 */
  .mi-quit { color: #ea6c6c; border-bottom: none; }
</style>

<script>
import router from '@system.router'
import { loadAutoSave } from '../../common/reader.js'

export default {
  protected: {
    hasAuto: false,
    bgSrc: '/common/img/ui/title_bg.png',
    logoSrc: '/common/img/ui/logo.png',
  },

  onInit() { this.refresh() },
  onShow() { this.refresh() },

  refresh() {
    loadAutoSave((d) => { this.hasAuto = !!(d && d.state) })
  },

  ban() {},
  start() { router.push({ uri: 'pages/game', params: { at: 'Chapter_0' } }) },
  resume() { router.push({ uri: 'pages/game', params: { auto: '1' } }) },
  openChapters() { router.push({ uri: 'pages/chapters' }) },
  openCg() { router.push({ uri: 'pages/cg' }) },
  openSettings() { router.push({ uri: 'pages/settings' }) },
  openAbout() { router.push({ uri: 'pages/about' }) },

  exitApp() {
    try { this.$app.exit() } catch (e) { router.replace({ uri: 'pages/index' }) }
  },
}
</script>
